digraph triage {
  rankdir=TB; splines=true; nodesep=0.18; ranksep=0.42; bgcolor="transparent";
  node [shape=box, style="rounded,filled", fillcolor="#F3F6FA", color="#1F4E79", fontname="Lato", fontsize=11, margin="0.11,0.07"];
  edge [color="#1F4E79", fontname="Lato", fontsize=9, arrowsize=0.7];

  new    [label="New issue via the form"];
  auto   [label="Type set by the form\nlabel: needs: triage", fillcolor="#E4ECF5"];
  look   [label="First look by\nwhoever triages", shape=diamond, style="filled", fillcolor="#FFFFFF", height=0.9];
  disc   [label="Convert to a Discussion\nor point to the forum"];
  close  [label="Close with a reason:\nduplicate, not planned"];
  info   [label="needs: info + comment\nreporter has 30 days"];
  accept [label="Accepted: remove needs: triage\noptionally Priority, blocker,\nconcern label, milestone, board", fillcolor="#E4ECF5"];
  work   [label="Work: assignee, draft PR,\nchecks, review, merge"];
  done   [label="Closed as completed", fillcolor="#E4ECF5"];

  { rank=same; disc; close; info; accept; }
  new -> auto -> look;
  look -> disc; look -> close; look -> info; look -> accept;
  info -> look [xlabel="reply", style=dashed, constraint=false];
  info -> close [xlabel="silence", style=dashed, constraint=false];
  accept -> work -> done;
}
